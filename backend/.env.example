# Database (Neon free tier — https://neon.tech)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/swingiq?sslmode=require

# Redis (Upstash free tier — https://upstash.com)
REDIS_URL=rediss://default:xxx@us1-xxx.upstash.io:6379

# Celery broker (defaults to REDIS_URL if not set)
CELERY_BROKER_URL=rediss://default:xxx@us1-xxx.upstash.io:6379/0

# Supabase Auth (free tier — https://supabase.com)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin (your email — only this user can send invites)
ADMIN_EMAIL=you@example.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Frontend URL (for CORS)
FRONTEND_URL=https://swingiq.vercel.app
